<Window x:Class="SpeedTestCS.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Speed Test CS" Height="580" Width="900"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <!-- Sayfa Yüklenme Animasyonu -->
        <Storyboard x:Key="WindowLoadAnim">
            <DoubleAnimation Storyboard.TargetName="MainGrid" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.6">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="MainGrid" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" From="30" To="0" Duration="0:0:0.6">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <Storyboard x:Key="WindowCloseAnim">
            <DoubleAnimation Storyboard.TargetName="MainGrid" Storyboard.TargetProperty="Opacity" From="1" To="0" Duration="0:0:0.4">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseIn"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="MainGrid" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" From="0" To="30" Duration="0:0:0.4">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseIn"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <!-- Premium Navigasyon Buton Stili (Aktif sayfa belirteçli) -->
        <Style TargetType="RadioButton" x:Key="NavBtnStyle">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource SubTextBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="45"/>
            <Setter Property="Margin" Value="0,5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid Background="Transparent">
                            <Border x:Name="BgBorder" Background="{TemplateBinding Background}" CornerRadius="8" Margin="10,0"/>
                            <!-- Sol taraftaki aktiflik çizgisi -->
                            <Border x:Name="ActiveIndicator" Background="{DynamicResource AccentBrush}" Width="4" HorizontalAlignment="Left" CornerRadius="2" Margin="10,8,0,8" Opacity="0">
                                <Border.RenderTransform>
                                    <TranslateTransform X="-10"/>
                                </Border.RenderTransform>
                            </Border>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BgBorder" Property="Background" Value="{DynamicResource NavActiveBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="BgBorder" Property="Background" Value="{DynamicResource NavActiveBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ActiveIndicator" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2"/>
                                            <DoubleAnimation Storyboard.TargetName="ActiveIndicator" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" To="0" Duration="0:0:0.3">
                                                <DoubleAnimation.EasingFunction>
                                                    <BackEase EasingMode="EaseOut" Amplitude="0.5"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ActiveIndicator" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2"/>
                                            <DoubleAnimation Storyboard.TargetName="ActiveIndicator" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" To="-10" Duration="0:0:0.2"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Premium Test Başlat Butonu -->
        <Style TargetType="Button" x:Key="StartBtnStyle">
            <Setter Property="Foreground" Value="{DynamicResource BgBrush}"/>
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontWeight" Value="ExtraBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <!-- Arkadaki Parlama (Glow) Efekti -->
                            <Border x:Name="Glow" CornerRadius="100" Opacity="0.5">
                                <Border.Background>
                                    <RadialGradientBrush>
                                        <GradientStop Color="{DynamicResource {x:Static SystemColors.HighlightColorKey}}" Offset="0"/>
                                        <GradientStop Color="Transparent" Offset="1"/>
                                    </RadialGradientBrush>
                                </Border.Background>
                                <Border.Effect>
                                    <BlurEffect Radius="35"/>
                                </Border.Effect>
                            </Border>
                            <!-- Ana Buton Yüzeyi -->
                            <Border x:Name="BtnBorder" CornerRadius="100">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="{DynamicResource {x:Static SystemColors.HighlightColorKey}}" Offset="0"/>
                                        <GradientStop Color="{DynamicResource {x:Static SystemColors.HotTrackColorKey}}" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Glow" Property="Opacity" Value="0.8"/>
                                <Setter TargetName="BtnBorder" Property="Opacity" Value="0.9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Pencere Kontrol Butonları -->
        <Style TargetType="Button" x:Key="WindowControlBtn">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource SubTextBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#33FF0000"/>
                    <Setter Property="Foreground" Value="#FF4444"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Window.Triggers>
        <!-- Form Yüklendiğinde Animasyonu Tetikle -->
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard Storyboard="{StaticResource WindowLoadAnim}"/>
        </EventTrigger>
    </Window.Triggers>

    <Border Background="Transparent" Padding="15">
        <Border x:Name="MainGrid" Background="{DynamicResource BgBrush}" CornerRadius="15" Opacity="0">
            <Border.RenderTransform>
                <TranslateTransform Y="30"/>
            </Border.RenderTransform>
            <Border.Effect>
                <DropShadowEffect BlurRadius="25" ShadowDepth="5" Opacity="0.4" Direction="270"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="50"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Title Bar -->
                <Grid Grid.Row="0" MouseDown="TitleBar_MouseDown" Background="Transparent">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="25,0,0,0">
                        <Ellipse Width="12" Height="12" Fill="{DynamicResource AccentBrush}"/>
                        <TextBlock Text="{DynamicResource StrAppName}" Foreground="{DynamicResource TextBrush}" 
                                   FontWeight="Bold" FontSize="16" Margin="10,0,0,0"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,10,0">
                        <Button Content="—" Width="40" Height="30" Style="{StaticResource WindowControlBtn}" Click="MinBtn_Click"/>
                        <Button Content="✕" Width="40" Height="30" Style="{StaticResource WindowControlBtn}" Click="CloseBtn_Click"/>
                    </StackPanel>
                </Grid>

                <!-- Sol Menü ve İçerik -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Sidebar -->
                    <Border Grid.Column="0" Margin="0,0,0,20">
                        <StackPanel Margin="0,30,0,10">
                            <!-- RadioButton Kullanımı: Aktif sayfayı takip eder -->
                            <RadioButton x:Name="RbNavHome" GroupName="Navigation" Content="{DynamicResource StrHome}" 
                                         Style="{StaticResource NavBtnStyle}" IsChecked="True" Click="NavHome_Click"/>
                            <RadioButton x:Name="RbNavSettings" GroupName="Navigation" Content="{DynamicResource StrSettings}" 
                                         Style="{StaticResource NavBtnStyle}" Click="NavSettings_Click"/>
                        </StackPanel>
                    </Border>

                    <!-- İçerik Alanı -->
                    <Grid Grid.Column="1" Margin="10,0,30,30">

                        <!-- HOME SAYFASI -->
                        <Grid x:Name="PageHome">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Sonuç Kartları -->
                            <UniformGrid Columns="3" Grid.Row="0" Margin="0,20,0,0">
                                <!-- Ping Kartı -->
                                <Border Background="{DynamicResource CardBrush}" CornerRadius="16" Margin="8" Padding="25">
                                    <Grid>
                                        <Path Data="M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2M12,4A8,8 0 0,1 20,12A8,8 0 0,1 12,20A8,8 0 0,1 4,12A8,8 0 0,1 12,4M11,7V13L16.2,16.1L17,14.9L12.5,12.2V7H11Z" 
                                              Fill="{DynamicResource SubTextBrush}" Opacity="0.1" Stretch="Uniform" Width="60" HorizontalAlignment="Right" VerticalAlignment="Top"/>
                                        <StackPanel>
                                            <TextBlock Text="{DynamicResource StrPing}" Foreground="{DynamicResource SubTextBrush}" FontSize="15" FontWeight="SemiBold"/>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,15,0,0">
                                                <TextBlock x:Name="TxtPing" Text="--" Foreground="{DynamicResource TextBrush}" FontSize="36" FontWeight="Bold"/>
                                                <TextBlock Text=" ms" Foreground="{DynamicResource SubTextBrush}" FontSize="16" VerticalAlignment="Bottom" Margin="5,0,0,8"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <!-- Download Kartı -->
                                <Border Background="{DynamicResource CardBrush}" CornerRadius="16" Margin="8" Padding="25">
                                    <Grid>
                                        <Path Data="M11,4H13V13.1L16.5,9.6L17.9,11L12,16.9L6.1,11L7.5,9.6L11,13.1V4M2,20V22H22V20H2Z" 
                                              Fill="{DynamicResource SubTextBrush}" Opacity="0.1" Stretch="Uniform" Width="60" HorizontalAlignment="Right" VerticalAlignment="Top"/>
                                        <StackPanel>
                                            <TextBlock Text="{DynamicResource StrDownload}" Foreground="{DynamicResource SubTextBrush}" FontSize="15" FontWeight="SemiBold"/>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,15,0,0">
                                                <TextBlock x:Name="TxtDownload" Text="--" Foreground="{DynamicResource TextBrush}" FontSize="36" FontWeight="Bold"/>
                                                <TextBlock Text=" Mbps" Foreground="{DynamicResource SubTextBrush}" FontSize="16" VerticalAlignment="Bottom" Margin="5,0,0,8"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <!-- Upload Kartı -->
                                <Border Background="{DynamicResource CardBrush}" CornerRadius="16" Margin="8" Padding="25">
                                    <Grid>
                                        <Path Data="M11,20H13V10.9L16.5,14.4L17.9,13L12,7.1L6.1,13L7.5,14.4L11,10.9V20M2,2V4H22V2H2Z" 
                                              Fill="{DynamicResource SubTextBrush}" Opacity="0.1" Stretch="Uniform" Width="60" HorizontalAlignment="Right" VerticalAlignment="Top"/>
                                        <StackPanel>
                                            <TextBlock Text="{DynamicResource StrUpload}" Foreground="{DynamicResource SubTextBrush}" FontSize="15" FontWeight="SemiBold"/>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,15,0,0">
                                                <TextBlock x:Name="TxtUpload" Text="--" Foreground="{DynamicResource TextBrush}" FontSize="36" FontWeight="Bold"/>
                                                <TextBlock Text=" Mbps" Foreground="{DynamicResource SubTextBrush}" FontSize="16" VerticalAlignment="Bottom" Margin="5,0,0,8"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </UniformGrid>

                            <!-- Başlat Butonu Alanı -->
                            <Grid Grid.Row="1">
                                <Button x:Name="BtnStartTest" Content="{DynamicResource StrStartTest}" Style="{StaticResource StartBtnStyle}" 
                                        Width="210" Height="210" Click="BtnStartTest_Click">
                                    <Button.RenderTransform>
                                        <ScaleTransform ScaleX="1" ScaleY="1" CenterX="105" CenterY="105"/>
                                    </Button.RenderTransform>
                                </Button>

                                <!-- Test Durumu -->
                                <TextBlock x:Name="TxtStatus" Text="" Foreground="{DynamicResource AccentBrush}" 
                                           FontSize="18" FontWeight="Medium" HorizontalAlignment="Center" 
                                           VerticalAlignment="Bottom" Margin="0,0,0,40" Opacity="0"/>
                            </Grid>
                        </Grid>

                        <!-- AYARLAR SAYFASI -->
                        <Grid x:Name="PageSettings" Visibility="Collapsed" Opacity="0">
                            <Border Background="{DynamicResource CardBrush}" CornerRadius="16" Padding="40">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource StrSettings}" Foreground="{DynamicResource TextBrush}" FontSize="32" FontWeight="Bold" Margin="0,0,0,40"/>

                                    <TextBlock Text="{DynamicResource StrTheme}" Foreground="{DynamicResource SubTextBrush}" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,15"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,35">
                                        <RadioButton x:Name="RbDark" Content="{DynamicResource StrDark}" Foreground="{DynamicResource TextBrush}" FontSize="16" Margin="0,0,30,0" Checked="Theme_Changed"/>
                                        <RadioButton x:Name="RbLight" Content="{DynamicResource StrLight}" Foreground="{DynamicResource TextBrush}" FontSize="16" Checked="Theme_Changed"/>
                                    </StackPanel>

                                    <TextBlock Text="{DynamicResource StrLanguage}" Foreground="{DynamicResource SubTextBrush}" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,15"/>
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton x:Name="RbTr" Content="Türkçe" Foreground="{DynamicResource TextBrush}" FontSize="16" Margin="0,0,30,0" Checked="Lang_Changed"/>
                                        <RadioButton x:Name="RbEn" Content="English" Foreground="{DynamicResource TextBrush}" FontSize="16" Checked="Lang_Changed"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Grid>

                    </Grid>
                </Grid>
            </Grid>
        </Border>
    </Border>
</Window>